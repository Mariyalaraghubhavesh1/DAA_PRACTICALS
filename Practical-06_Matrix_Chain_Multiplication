#include <iostream>
#include <vector>
#include <climits>
using namespace std;

// Function to print optimal parenthesization
void printOptimalOrder(const vector<vector<int>>& split, int i, int j)
{
    if (i == j)
    {
        cout << "A" << i;
        return;
    }

    cout << "(";

    printOptimalOrder(split, i, split[i][j]);
    cout << " x ";
    printOptimalOrder(split, split[i][j] + 1, j);

    cout << ")";
}

// Matrix Chain Multiplication
int matrixChainMultiplication(const vector<int>& p, int n)
{
    vector<vector<long long>> dp(n + 1,
                                 vector<long long>(n + 1, 0));

    vector<vector<int>> split(n + 1,
                              vector<int>(n + 1, 0));

    // chainLength represents the number of matrices
    for (int chainLength = 2; chainLength <= n; chainLength++)
    {
        for (int i = 1; i <= n - chainLength + 1; i++)
        {
            int j = i + chainLength - 1;

            dp[i][j] = LLONG_MAX;

            for (int k = i; k < j; k++)
            {
                long long cost =
                    dp[i][k] +
                    dp[k + 1][j] +
                    1LL * p[i - 1] * p[k] * p[j];

                if (cost < dp[i][j])
                {
                    dp[i][j] = cost;
                    split[i][j] = k;
                }
            }
        }
    }

    cout << "\nMinimum number of scalar multiplications: "
         << dp[1][n] << endl;

    cout << "Optimal Parenthesization: ";
    printOptimalOrder(split, 1, n);
    cout << endl;

    // Display DP table
    cout << "\nDP Table:\n";

    for (int i = 1; i <= n; i++)
    {
        for (int j = 1; j <= n; j++)
        {
            if (i > j)
                cout << "-\t";
            else
                cout << dp[i][j] << "\t";
        }
        cout << endl;
    }

    return dp[1][n];
}

int main()
{
    int n;

    cout << "Enter number of matrices: ";
    cin >> n;

    if (n <= 0)
    {
        cout << "Invalid number of matrices." << endl;
        return 0;
    }

    vector<int> dimensions(n + 1);

    cout << "Enter dimensions of matrices:\n";
    cout << "For n matrices, enter n+1 dimensions.\n";

    for (int i = 0; i <= n; i++)
    {
        cin >> dimensions[i];
    }

    // Validate dimensions
    for (int i = 0; i <= n; i++)
    {
        if (dimensions[i] <= 0)
        {
            cout << "Dimensions must be positive." << endl;
            return 0;
        }
    }

    cout << "\nMatrix Dimensions:\n";

    for (int i = 1; i <= n; i++)
    {
        cout << "A" << i << " = "
             << dimensions[i - 1]
             << " x "
             << dimensions[i]
             << endl;
    }

    matrixChainMultiplication(dimensions, n);

    return 0;
}
