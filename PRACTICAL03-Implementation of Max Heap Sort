#include <iostream>
#include <vector>
#include <iomanip>
using namespace std;

void printArray(const vector<int>& a)
{
    for (int x : a)
        cout << x << " ";

    cout << endl;
}

// ============================================
// MAX HEAPIFY
// ============================================
void maxHeapify(vector<int>& a, int n, int i,
                long long& comparisons)
{
    int largest = i;

    int left = 2 * i + 1;
    int right = 2 * i + 2;

    if (left < n)
    {
        comparisons++;

        if (a[left] > a[largest])
            largest = left;
    }

    if (right < n)
    {
        comparisons++;

        if (a[right] > a[largest])
            largest = right;
    }

    if (largest != i)
    {
        swap(a[i], a[largest]);

        maxHeapify(a, n, largest, comparisons);
    }
}

// ============================================
// BUILD MAX HEAP
// ============================================
void buildMaxHeap(vector<int>& a,
                  long long& comparisons)
{
    int n = a.size();

    for (int i = n / 2 - 1; i >= 0; i--)
    {
        maxHeapify(a, n, i, comparisons);
    }
}

// ============================================
// HEAP SORT
// ============================================
void heapSort(vector<int>& a,
              long long& comparisons)
{
    comparisons = 0;

    int n = a.size();

    // Step 1: Build Max Heap
    buildMaxHeap(a, comparisons);

    // Step 2: Extract maximum repeatedly
    for (int i = n - 1; i > 0; i--)
    {
        // Move maximum element to the end
        swap(a[0], a[i]);

        // Restore Max Heap property
        maxHeapify(a, i, 0, comparisons);
    }
}

// ============================================
// MAIN FUNCTION
// ============================================
int main()
{
    cout << "============================================\n";
    cout << "       PRACTICAL 03 - MAX HEAP SORT\n";
    cout << "============================================\n\n";

    int n;

    cout << "Enter number of elements: ";
    cin >> n;

    if (n <= 0)
    {
        cout << "Invalid number of elements.\n";
        return 0;
    }

    vector<int> a(n);

    cout << "\nEnter " << n << " elements:\n";

    for (int i = 0; i < n; i++)
    {
        cin >> a[i];
    }

    // Display original array
    cout << "\nOriginal Array:\n";
    printArray(a);

    long long comparisons = 0;

    // Perform Heap Sort
    heapSort(a, comparisons);

    // Display sorted array
    cout << "\nSorted Array:\n";
    printArray(a);

    // Display comparisons
    cout << "\nNumber of comparisons: "
         << comparisons << endl;

    // ========================================
    // COMPLEXITY
    // ========================================

    cout << "\n============================================\n";
    cout << "                COMPLEXITY\n";
    cout << "============================================\n";

    cout << "Build Max Heap : O(n)\n";
    cout << "Max Heapify    : O(log n)\n";
    cout << "Heap Sort      : O(n log n)\n";
    cout << "Auxiliary Space: O(1)\n";

    // ========================================
    // CONCLUSION
    // ========================================

    cout << "\n============================================\n";
    cout << "                 CONCLUSION\n";
    cout << "============================================\n";

    cout << "Max Heap Sort successfully sorted the array.\n";
    cout << "It provides O(n log n) time in all cases\n";
    cout << "and performs sorting in-place.\n";

    return 0;
}
